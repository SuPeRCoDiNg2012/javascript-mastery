# Public build-time configuration.
# The app runs entirely in guest mode when these are absent.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: error tracking (Sentry). Leave empty to disable.
VITE_SENTRY_DSN=

# Never put a service_role key in a Vite project: everything prefixed with
# VITE_ ends up in the client bundle.
